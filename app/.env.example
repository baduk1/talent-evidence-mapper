# Демо-конфигурация для курса. Не настоящие секреты.
# Рабочий файл .env копируется отсюда и в git не попадает.
APP_ENV=development
APP_NAME=talent-evidence-mapper

POSTGRES_USER=tem
POSTGRES_PASSWORD=tem_password
POSTGRES_DB=tem
DATABASE_URL=postgresql+psycopg2://tem:tem_password@database:5432/tem

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
JWT_SECRET=dev-secret-change-me

# Токен Telegram-бота от @BotFather (без него сервис bot не стартует)
TELEGRAM_BOT_TOKEN=put-your-bot-token-here